{
  "manifest_version": 3,
  "name": "ResumeRadar",
  "version": "0.1.0",
  "description": "Auto-track job applications from Naukri and LinkedIn with AI-powered resume matching",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.naukri.com/*",
    "*://*.linkedin.com/*",
    "http://localhost:8001/*",
    "http://localhost:8002/*",
    "http://localhost:8003/*",
    "http://localhost:8004/*",
    "http://localhost:8005/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-B9sJ2ysn.js"
      ],
      "matches": [
        "*://*.naukri.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.naukri.com/*"
      ],
      "resources": [
        "icons/*",
        "assets/index.ts-B9sJ2ysn.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
